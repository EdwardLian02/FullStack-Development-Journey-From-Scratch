<%
    /*
      Checkout. Submits to POST /create-order with the fields below.
      Expects: cart  { items: [ { product: {id, title, price, imageUrl}, qty } ] }
    */
    const money = (n) => '$' + Number(n || 0).toFixed(2);
    const items = (typeof cart !== 'undefined' && cart && cart.items) ? cart.items : [];
    const total = items.reduce((sum, i) => sum + Number(i.product.price || 0) * i.qty, 0);
%>
<%- include('../includes/head.ejs') %>
</head>
<body>
    <%- include('../includes/navigation.ejs') %>

    <main>
        <a class="crumb" href="/cart">&larr; Back to cart</a>
        <div class="page-head">
            <h1>Checkout</h1>
        </div>

        <% if (items.length === 0) { %>
            <div class="empty">
                <h2>Nothing to check out</h2>
                <p>Your cart is empty. Add a product first.</p>
                <a class="btn" href="/products">Browse products</a>
            </div>
        <% } else { %>
            <form class="split" action="/create-order" method="POST">
                <div class="form" style="gap: 2.5rem;">
                    <fieldset class="fieldset">
                        <legend>Contact</legend>
                        <div class="field">
                            <label for="email">Email</label>
                            <input class="input" id="email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
                            <span class="hint">We'll send your order confirmation here.</span>
                        </div>
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend>Shipping address</legend>
                        <div class="field">
                            <label for="fullName">Full name</label>
                            <input class="input" id="fullName" type="text" name="fullName" autocomplete="name" required>
                        </div>
                        <div class="field">
                            <label for="address">Address</label>
                            <input class="input" id="address" type="text" name="address" autocomplete="street-address" required>
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label for="city">City</label>
                                <input class="input" id="city" type="text" name="city" autocomplete="address-level2" required>
                            </div>
                            <div class="field">
                                <label for="postalCode">Postal code</label>
                                <input class="input" id="postalCode" type="text" name="postalCode" autocomplete="postal-code" required>
                            </div>
                        </div>
                        <div class="field">
                            <label for="country">Country</label>
                            <input class="input" id="country" type="text" name="country" autocomplete="country-name" required>
                        </div>
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend>Payment</legend>
                        <label class="choice">
                            <input type="radio" name="paymentMethod" value="cash-on-delivery" checked>
                            <div><strong>Pay on delivery</strong><span>Pay in cash when your order arrives.</span></div>
                        </label>
                        <label class="choice">
                            <input type="radio" name="paymentMethod" value="bank-transfer">
                            <div><strong>Bank transfer</strong><span>We'll email you the account details.</span></div>
                        </label>
                    </fieldset>
                </div>

                <aside class="summary" aria-label="Order summary">
                    <h2>Your order</h2>
                    <ul class="mini">
                        <% for (const item of items) { %>
                            <li>
                                <%- include('../includes/tile.ejs', { product: item.product, size: 'thumb' }) %>
                                <div class="mini__body">
                                    <p class="mini__name"><%= item.product.title %></p>
                                    <p class="mini__qty num">Qty <%= item.qty %></p>
                                </div>
                                <span class="price"><%= money(Number(item.product.price) * item.qty) %></span>
                            </li>
                        <% } %>
                    </ul>
                    <div class="summary__row"><span>Shipping</span><span>Free</span></div>
                    <div class="summary__row summary__row--total"><span>Total</span><span class="price"><%= money(total) %></span></div>

                    <div class="summary__actions">
                        <button class="btn btn--block" type="submit">Place order</button>
                    </div>
                </aside>
            </form>
        <% } %>
    </main>
<%- include('../includes/end.ejs') %>
