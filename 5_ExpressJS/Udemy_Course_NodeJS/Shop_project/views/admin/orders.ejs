<%
    /*
      Admin: manage orders.
      Expects: orders  array of
        {
          id, date, status,                       // status: pending | processing | shipped | delivered | cancelled
          customer: { name, email },
          shipping: { address, city, postalCode, country },
          paymentMethod,
          items: [ { title, price, qty } ],       // a snapshot of what was bought
          total                                    // optional; calculated from items if missing
        }
      Status changes post to /admin/update-order-status with { orderId, status }.
    */
    const money = (n) => '$' + Number(n || 0).toFixed(2);
    const list = typeof orders !== 'undefined' ? orders : [];
    const statuses = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    const label = (s) => s.charAt(0).toUpperCase() + s.slice(1);
    const orderTotal = (o) => o.total != null ? o.total : (o.items || []).reduce((sum, i) => sum + Number(i.price) * i.qty, 0);
    const fmtDate = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    const openCount = list.filter((o) => o.status === 'pending' || o.status === 'processing').length;
%>
<%- include('../includes/head.ejs') %>
</head>
<body>
    <%- include('../includes/navigation.ejs') %>

    <main>
        <div class="page-head">
            <h1>Admin</h1>
            <% if (list.length > 0) { %>
                <p class="page-head__meta"><%= list.length %> <%= list.length === 1 ? 'order' : 'orders' %>, <%= openCount %> to handle</p>
            <% } %>
        </div>

        <%- include('../includes/admin-nav.ejs') %>

        <% if (list.length > 0) { %>
            <div class="orders">
                <% for (const order of list) { %>
                    <details class="order">
                        <summary>
                            <span class="order__id num">#<%= order.id %></span>
                            <span class="order__who">
                                <%= order.customer && order.customer.name ? order.customer.name : 'Guest' %>
                                <% if (order.customer && order.customer.email) { %><span><%= order.customer.email %></span><% } %>
                            </span>
                            <span class="order__date"><%= fmtDate(order.date) %></span>
                            <span class="order__total price"><%= money(orderTotal(order)) %></span>
                            <span class="status status--<%= order.status %>"><%= label(order.status) %></span>
                            <span class="order__chev" aria-hidden="true"></span>
                        </summary>

                        <div class="order__body">
                            <div>
                                <h3>Items</h3>
                                <ul class="order__items">
                                    <% for (const item of (order.items || [])) { %>
                                        <li>
                                            <span><%= item.title %> <span class="num" style="color: var(--muted);">&times; <%= item.qty %></span></span>
                                            <span class="price"><%= money(Number(item.price) * item.qty) %></span>
                                        </li>
                                    <% } %>
                                </ul>
                            </div>

                            <div>
                                <h3>Ship to</h3>
                                <% if (order.shipping) { %>
                                    <address class="order__address">
                                        <%= order.shipping.address %><br>
                                        <%= order.shipping.postalCode %> <%= order.shipping.city %><br>
                                        <%= order.shipping.country %>
                                    </address>
                                <% } else { %>
                                    <p class="order__address">No address on file.</p>
                                <% } %>

                                <% if (order.paymentMethod) { %>
                                    <h3>Payment</h3>
                                    <p class="order__address" style="text-transform: capitalize;"><%= String(order.paymentMethod).replace(/-/g, ' ') %></p>
                                <% } %>

                                <h3>Status</h3>
                                <form class="order__status-form" action="/admin/update-order-status" method="POST">
                                    <input type="hidden" name="orderId" value="<%= order.id %>">
                                    <label class="sr-only" for="status-<%= order.id %>">Order status</label>
                                    <select class="select" id="status-<%= order.id %>" name="status">
                                        <% for (const s of statuses) { %>
                                            <option value="<%= s %>" <%= s === order.status ? 'selected' : '' %>><%= label(s) %></option>
                                        <% } %>
                                    </select>
                                    <button class="btn btn--sm" type="submit">Update</button>
                                </form>
                            </div>
                        </div>
                    </details>
                <% } %>
            </div>
        <% } else { %>
            <div class="empty">
                <h2>No orders yet</h2>
                <p>When customers check out, their orders will show up here.</p>
                <a class="btn btn--ghost" href="/products">View the shop</a>
            </div>
        <% } %>
    </main>
<%- include('../includes/end.ejs') %>
